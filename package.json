{
  "name": "vouch",
  "private": true,
  "version": "0.0.0",
  "description": "Pay-to-unlock 280-character posts, each with a token on a bonding curve",
  "scripts": {
    "setup": "npm --prefix apps/web ci && npm --prefix apps/server ci",
    "dev": "npm --prefix apps/web run dev",
    "build": "npm --prefix apps/web run build",
    "build:demo": "npm --prefix apps/web run build:demo",
    "preview": "npm --prefix apps/web run preview",
    "lint": "npm --prefix apps/web run lint",
    "server": "npm --prefix apps/server run start",
    "server:testnet": "npm --prefix apps/server run start:testnet",
    "server:mainnet": "npm --prefix apps/server run start:mainnet",
    "server:test": "npm --prefix apps/server run test",
    "typecheck": "npm --prefix apps/server run typecheck && npm --prefix apps/web run build",
    "pay-test": "npm --prefix apps/server run pay-test --",
    "hackathon": "node scripts/hackathon.mjs"
  }
}
