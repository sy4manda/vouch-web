{
  "name": "vouch-server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=../../.env --import tsx src/index.ts",
    "start:testnet": "node --env-file-if-exists=../../.env --env-file=../../.env.testnet --import tsx src/index.ts",
    "start:mainnet": "node --env-file-if-exists=../../.env --env-file=../../.env.mainnet --import tsx src/index.ts",
    "test": "node --test --import tsx \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json",
    "launch": "node --env-file-if-exists=../../.env --import tsx src/chain/launch.ts",
    "keeper": "node --env-file-if-exists=../../.env --import tsx src/bankr/keeper.ts",
    "pay-test": "node --env-file-if-exists=../../.env --env-file=../../.env.mainnet --import tsx scripts/pay-test.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@privy-io/node": {
      "@solana/kit": "^6.3.1"
    }
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@privy-io/node": "^0.34.0",
    "@whetstone-research/doppler-sdk": "^1.0.43",
    "hono": "^4.13.8",
    "viem": "^2.56.8",
    "x402-fetch": "^1.2.0"
  }
}
