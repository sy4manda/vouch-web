# ---- frontend: leave both empty to run fully in demo mode (sample data, fake wallet) ----
VITE_PRIVY_APP_ID=
VITE_API_URL=
# Optional: your own Base RPC for balance reads and tx receipts
VITE_BASE_RPC_URL=

# ---- backend (npm run server) ----
PORT=8787
CORS_ORIGIN=http://localhost:5173
DB_PATH=vouch.db
NETWORK=base               # or baseSepolia
RPC_URL=                     # a Base RPC with eth_getLogs; the public endpoint rate-limits the indexer

# Privy: same app as VITE_PRIVY_APP_ID, plus its secret
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Platform key: pays gas to launch every token (we sponsor posting)
DEPLOYER_PRIVATE_KEY=
PROTOCOL_ADDRESS=            # receives the 15% fee share; defaults to the deployer

# Bankr
BANKR_WALLET=                # x402 payTo: the Bankr wallet that receives unlock fees
BANKR_API_KEY=               # Wallet API write access (bankr.bot/api-keys), this machine's IP allowlisted
PUBLIC_API_URL=              # public URL of THIS backend; deployed x402 handlers call it
WEBHOOK_SECRET=              # long random string; per-post handler secrets are derived from it
BUYBACK_MODE=keeper          # keeper (server/buyback.ts) or agent (handler asks the Bankr agent)
# KEEPER_MIN_USDC=0.25  KEEPER_INTERVAL_MS=30000  INDEXER_START_BLOCK=  AGENT_BUYBACK_EVERY=5
