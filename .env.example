# ---- frontend: leave both empty to run fully in demo mode (sample data, fake wallet) ----
# On Vercel these VITE_* values are set in the project dashboard (build-time), not only in this file.
VITE_PRIVY_APP_ID=
VITE_API_URL=
# Optional: your own Base RPC for balance reads and tx receipts
VITE_BASE_RPC_URL=

# ---- backend (npm run server | npm run hackathon) ----
PORT=8787
# Browser Origin allowlist. Comma-separated. For a Vercel frontend this is https://<app>.vercel.app
# (add http://localhost:5173 if you also run Vite against the same API).
CORS_ORIGIN=http://localhost:5173
# Defaults for plain `npm run server`. Prefer the per-network overlays described at the bottom.
DB_PATH=data/vouch.db
NETWORK=base               # or baseSepolia
RPC_URL=                     # a Base RPC with eth_getLogs; the public endpoint rate-limits the indexer

# Privy: same app as VITE_PRIVY_APP_ID, plus its secret
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Platform key: pays gas to launch every token (we sponsor posting)
DEPLOYER_PRIVATE_KEY=
PROTOCOL_ADDRESS=            # receives the 15% fee share; defaults to the deployer

# Bankr
BANKR_WALLET=                # x402 payTo: the Bankr wallet that receives unlock fees
BANKR_API_KEY=               # Wallet API write access (bankr.bot/api-keys), this machine's IP allowlisted
PUBLIC_API_URL=              # public URL of THIS backend; deployed x402 handlers call it
WEBHOOK_SECRET=              # long random string; per-post handler secrets are derived from it
BUYBACK_MODE=off             # off (hackathon: record fees, do not swap) | keeper | agent
# KEEPER_MIN_USDC=0.25  KEEPER_INTERVAL_MS=30000  INDEXER_START_BLOCK=  AGENT_BUYBACK_EVERY=5

# ---- hackathon: Vercel SPA + this laptop's API via ngrok (npm run hackathon) ----
# Claim the free static domain in the ngrok dashboard, then set all three. The Vercel env VITE_API_URL
# must be the same https URL (dashboard, then redeploy). CORS_ORIGIN above must be the Vercel origin.
NGROK_DOMAIN=
TRUST_PROXY=1

# ---- one overlay per network (both gitignored) ----
# Keep shared values (Privy, Bankr, WEBHOOK_SECRET, ...) in .env. Put only what differs in:
#   .env.testnet  NETWORK=baseSepolia  DB_PATH=data/vouch-testnet.db  DEPLOYER_PRIVATE_KEY=<testnet key>
#   .env.mainnet  NETWORK=base         DB_PATH=data/vouch-mainnet.db  DEPLOYER_PRIVATE_KEY=<mainnet key>
# npm run server:testnet | npm run server:mainnet  loads .env, then the overlay (later files win).

# ---- Docker on a VPS (deploy/): the public hostname Caddy serves. PUBLIC_API_URL must be https://<API_DOMAIN>. ----
# API_DOMAIN=api.example.com

# ---- limits and safety (all optional; defaults shown). See docs/operations.md ----
# CORS_ORIGIN=https://your-app.vercel.app     REQUIRED when NODE_ENV=production (the Docker image sets it)
# TRUST_PROXY=1               set behind Caddy or ngrok so rate limits see real client IPs (compose / hackathon set it)
# RATE_LIMIT_PER_MIN=120      per client IP
# POSTS_PER_USER_PER_DAY=5    POSTS_PER_DAY_TOTAL=200    POST_COOLDOWN_SEC=30
# MIN_DEPLOYER_ETH=0.002      refuse new posts when the deployer holds less ETH than this
# KEEPER_MAX_SWAP_USDC=50     KEEPER_MAX_DAILY_USDC=250  KEEPER_RESERVE_USDC=0
# BANKR_FEE_BPS=0             Bankr's cut of each x402 payment (500 = 5%); measure it with `npm run pay-test`
# BACKUP_INTERVAL_HOURS=6     BACKUP_KEEP=14
# ALERT_WEBHOOK_URL=          Slack or Discord incoming webhook for [ALERT] messages
