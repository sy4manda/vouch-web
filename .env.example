# Copy this file to `.env` at the repo root. Never commit `.env`.
# A blank value is unset. `npm run hackathon` reads `.env`.

# --- Vercel dashboard (build-time) and local Vite ---
# After changing VITE_* on Vercel, redeploy. Leave both empty for in-browser demo mode.

# Same Privy app as PRIVY_APP_ID.
VITE_PRIVY_APP_ID=

# Public API URL, e.g. https://<your-ngrok-host>. Not localhost from Vercel.
VITE_API_URL=

# Optional Base RPC for balances and receipts.
VITE_BASE_RPC_URL=

# --- API on this laptop (`npm run hackathon` or `npm run server`) ---
PORT=8787

# Browser origins allowed to call the API (comma-separated, no trailing slash).
# Demo: CORS_ORIGIN=https://vouch-web-app.vercel.app,http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# ngrok hostname only (no https://), e.g. something.ngrok-free.dev
NGROK_DOMAIN=

# Must be https://<NGROK_DOMAIN>. Bankr x402 handlers POST unlocks here.
PUBLIC_API_URL=

# 1 behind ngrok so rate limits use the real client IP.
TRUST_PROXY=1

# Same app as VITE_PRIVY_APP_ID, plus the secret from the Privy dashboard.
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# 0x + 64 hex. Pays gas to gate a post (launch the token and deploy the x402 endpoint).
DEPLOYER_PRIVATE_KEY=

# Optional 15% fee recipient. Defaults to the deployer.
PROTOCOL_ADDRESS=

# 0x address. x402 payTo: unlock USDC is paid to this Bankr wallet.
BANKR_WALLET=

# Wallet API key. Required only when BUYBACK_MODE=keeper.
BANKR_API_KEY=

# Long random string. Per-post handler secrets are derived from this.
WEBHOOK_SECRET=

# off = record fees, do not swap (demo). keeper = swap+burn. agent = handler asks Bankr.
BUYBACK_MODE=off

# base or baseSepolia
NETWORK=base
DB_PATH=data/vouch.db

# Base RPC with eth_getLogs. Public endpoints rate-limit the indexer.
RPC_URL=

# --- Optional knobs (defaults in code) ---
# RATE_LIMIT_PER_MIN=120
# POSTS_PER_USER_PER_DAY=5    POSTS_PER_DAY_TOTAL=200    POST_COOLDOWN_SEC=30
# MIN_DEPLOYER_ETH=0.002
# KEEPER_MIN_USDC=0.25        KEEPER_INTERVAL_MS=30000   INDEXER_START_BLOCK=
# KEEPER_MAX_SWAP_USDC=50     KEEPER_MAX_DAILY_USDC=250  KEEPER_RESERVE_USDC=0
# BANKR_FEE_BPS=0             AGENT_BUYBACK_EVERY=5
# BACKUP_INTERVAL_HOURS=6     BACKUP_KEEP=14
# ALERT_WEBHOOK_URL=
